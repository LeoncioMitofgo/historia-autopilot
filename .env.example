# Copia este archivo como .env para desarrollo local (nunca lo subas a git).
# En producción, estas mismas variables van como GitHub Secrets del repo
# (Settings -> Secrets and variables -> Actions). Ver docs/AUDIT.md para
# saber dónde consigue cada una.

# Supabase (Settings -> API Keys del proyecto)
# SUPABASE_KEY debe ser la key de privilegio alto para uso de backend:
#   - proyectos nuevos: la "secret key" (empieza por sb_secret_...)
#   - proyectos con keys legacy: la "service_role" key
# NUNCA la "anon" / "publishable" -- esa es de bajo privilegio, pensada
# para código público (web/app), y no basta para lo que hacen estos scripts.
SUPABASE_URL=
SUPABASE_KEY=

# Proveedor de LLM para generate_script.py -- Gemini API es gratis y de
# sobra para el volumen de este proyecto (ver docs/DECISIONS.md punto 6).
# Este paso es opcional: si un mes prefieres escribir los guiones a mano e
# insertarlos directamente en la tabla `episodes` desde Supabase, no
# necesitas ninguna de estas keys ese mes.
GEMINI_API_KEY=
# GROQ_API_KEY=          # alternativa gratuita de respaldo
# OPENROUTER_API_KEY=    # alternativa gratuita de respaldo
# ANTHROPIC_API_KEY=     # opción de pago, mayor calidad si hace falta
# OPENAI_API_KEY=        # opción de pago, alternativa

# Voz (opcional -- si no se define, se usa Edge-TTS gratis por defecto)
ELEVENLABS_API_KEY=

# Assets de archivo real
PEXELS_API_KEY=
PIXABAY_API_KEY=

# YouTube Data API v3 (Google Cloud Console)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Meta Graph API (Instagram/Facebook, app en modo Tester -- ver docs/AUDIT.md)
META_ACCESS_TOKEN=
META_IG_BUSINESS_ID=
META_PAGE_ID=

# Tamaño del lote mensual de guiones
SCRIPT_BATCH_SIZE=10
