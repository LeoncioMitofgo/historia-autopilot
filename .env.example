# Copia este archivo como .env para desarrollo local (nunca lo subas a git).
# En producción, estas mismas variables van como GitHub Secrets del repo
# (Settings -> Secrets and variables -> Actions). Ver docs/AUDIT.md para
# saber dónde consigue cada una.

# Supabase (Settings -> API del proyecto)
SUPABASE_URL=
SUPABASE_KEY=

# Proveedor de LLM para generate_script.py (elegir uno, ver docs/AUDIT.md)
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Voz (opcional -- si no se define, se usa Edge-TTS gratis por defecto)
ELEVENLABS_API_KEY=

# Assets de archivo real
PEXELS_API_KEY=
PIXABAY_API_KEY=

# YouTube Data API v3 (Google Cloud Console)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Meta Graph API (Instagram/Facebook, app en modo Tester -- ver docs/AUDIT.md)
META_ACCESS_TOKEN=
META_IG_BUSINESS_ID=
META_PAGE_ID=

# Tamaño del lote mensual de guiones
SCRIPT_BATCH_SIZE=10
